alias: Scent Diffuser - Scheduled Runtime
description: >-
  Turn on the scent diffuser for 30 seconds every hour on the hour when Scott is
  home and the thermostat is in cool mode between 8:00 a.m. and 8:00 p.m.
trigger:
  - platform: time_pattern
    minutes: 0
condition:
  - condition: state
    entity_id: person.scott_funk
    state: home
  - condition: time
    after: "08:00:00"
    before: "20:00:00"
  - condition: state
    entity_id: climate.sensi_indoor_thermostat
    state: cool
action:
  - service: switch.turn_on
    target:
      entity_id: switch.scent_diffuser
    data: {}
  - delay:
      seconds: 30
  - service: switch.turn_off
    target:
      entity_id: switch.scent_diffuser
    data: {}
mode: single
