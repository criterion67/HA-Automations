alias: Attic Lights - Door Controlled
description: >-
  Attic light is switched on and off based on the open) closed state of either
  interior or garage attic doors.
trigger:
  - type: opened
    platform: device
    device_id: 2820e78f0d78bc62b27f2030701cee90
    entity_id: b0ecfdc2f2bef3aeaf81dbffcc5bf3bd
    domain: binary_sensor
    id: Attic Door 1 Open
  - type: not_opened
    platform: device
    device_id: 2820e78f0d78bc62b27f2030701cee90
    entity_id: b0ecfdc2f2bef3aeaf81dbffcc5bf3bd
    domain: binary_sensor
    id: Attic Door 1 Closed
  - type: opened
    platform: device
    device_id: a2adf50c21a62f02cd699cfcd4f11c83
    entity_id: cb426ff0b7cc6ef934c1d4956d2712e7
    domain: binary_sensor
    id: Attic Door 2 Open
  - type: not_opened
    platform: device
    device_id: a2adf50c21a62f02cd699cfcd4f11c83
    entity_id: cb426ff0b7cc6ef934c1d4956d2712e7
    domain: binary_sensor
    id: Attic Door 2 Closed
condition: []
action:
  - choose:
      - conditions:
          - condition: trigger
            id:
              - Attic Door 1 Open
              - Attic Door 2 Open
        sequence:
          - service: switch.turn_on
            target:
              entity_id:
                - switch.attic_hallway_light
                - switch.attic_garage_light
            data: {}
      - conditions:
          - condition: trigger
            id:
              - Attic Door 1 Closed
              - Attic Door 2 Closed
        sequence:
          - service: switch.turn_off
            target:
              entity_id:
                - switch.attic_hallway_light
                - switch.attic_garage_light
            data: {}
mode: single
