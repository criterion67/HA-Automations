alias: "Scent Diffuser - Scheduled 30 Minute Runtime "
description: >-
  Turn on the scent diffuser for 60 seconds every 30 minutes when Scott is home
  and the thermostat is in cool mode between 8:00 a.m. and 8:00 p.m.
trigger:
  - platform: time_pattern
    minutes: /30
condition:
  - condition: state
    entity_id: person.scott_funk
    state: home
  - condition: time
    after: "08:00:00"
    before: "20:00:00"
  - condition: state
    entity_id: climate.sensi_indoor_thermostat
    state: cool
action:
  - service: switch.turn_on
    target:
      entity_id: switch.scent_diffuser
    data: {}
  - delay:
      hours: 0
      minutes: 1
      seconds: 0
      milliseconds: 0
  - service: switch.turn_off
    target:
      entity_id: switch.scent_diffuser
    data: {}
mode: single
