alias: Possible Mail Delivery AI Notification
description: Detects possible USPS mail delivery from driveway camera.
triggers:
  - type: opened
    device_id: 34d1a941a890a926dd573a4a48cefa56
    entity_id: fc7cbdabfe74fcb44ecd7725fa6b5522
    domain: binary_sensor
    trigger: device
conditions: []
actions:
  - data:
      filename: /config/www/snapshots/doorbell.png
    action: camera.snapshot
    target:
      entity_id: camera.driveway_2_fluent_2
  - action: llmvision.image_analyzer
    metadata: {}
    data:
      include_filename: false
      target_width: 1280
      detail: high
      max_tokens: 100
      temperature: 0.2
      provider: 01JBPN7YR0C9Y9CGVMJ8TCQEZ5
      image_entity:
        - camera.driveway_2_fluent_2
      message: >-
        Is there a USPS mail truck in the snapshot? The mailbox is on a white
        post at the end of the driveway (right side). If seen, describe the
        vehicle's type, color, and time of day. Respond concisely.
    response_variable: response
  - delay:
      seconds: 1
  - data:
      message: "{{ response.response_text }}"
      title: Possible Mail Delivery! 🚗🏃‍♂️
      data:
        url: xxxxxxxxxxxxxxxxxxxxxxxxxx://
        image: /local/snapshots/doorbell.png
    action: notify.mobile_app_pixel_9
    enabled: true
mode: single
